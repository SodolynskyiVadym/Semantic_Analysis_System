@page "/player/{TaskId}/edit/transcript"
@using ClientApp.Models
@inject ApiService ApiService
@inject NavigationManager Nav

<div class="container-fluid px-4 mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark">Редактор транскрипту (STT)</h2>
            <div class="text-secondary" style="font-size: 1.1rem;">
                Виправлення текстового шару перехоплення
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark px-4 fw-bold rounded-1" @onclick='() => Nav.NavigateTo($"/player/{TaskId}")'>
                Скасувати
            </button>
            <button class="btn btn-dark px-4 fw-bold rounded-1 d-flex align-items-center" @onclick="SaveTranscript" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Збереження...</span>
                }
                else
                {
                    <span>💾 Зберегти текст</span>
                }
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-dark" role="status"></div>
        </div>
    }
    else if (_segments != null)
    {
        <div class="card rounded-1 border shadow-sm">
            <div class="card-header bg-light border-bottom py-3 px-4">
                <h6 class="fw-bold mb-0 text-dark text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                    Текстові сегменти ефіру
                </h6>
            </div>

            <div class="card-body p-4 transcript-area">
                <div class="alert alert-warning rounded-1 border-0 border-start border-4 border-warning mb-4 px-4 py-3 shadow-sm bg-opacity-10" style="background-color: #fff3cd;">
                    <span class="fw-bold text-dark">⚠️ Увага:</span>
                    <span class="text-dark">Зміна тексту може змістити індекси символів. Обов'язково перевірте розмітку сутностей (NER) після збереження тексту.</span>
                </div>

                @foreach (var segment in _segments)
                {
                    <div class="mb-3 d-flex align-items-start gap-3">
                        <span class="badge border bg-light text-secondary font-monospace mt-2 rounded-1" style="font-size: 0.9rem; min-width: 60px;">
                            @TimeSpan.FromSeconds(segment.Start).ToString(@"mm\:ss")
                        </span>
                        <input type="text" class="form-control form-control-lg rounded-1 transcript-input" @bind="segment.Text" />
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .transcript-area {
        min-height: 60vh;
        background-color: #ffffff;
    }

    .transcript-input {
        font-size: 1.15rem;
        color: #212529;
        border-color: #ced4da;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .transcript-input:focus {
            border-color: #212529;
            box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.1);
            background-color: #f8f9fa;
        }
</style>

@code {
    [Parameter] public string TaskId { get; set; } = "";
    private AudioTask? _rawServerData;
    private List<TranscribeSegmentDto>? _segments;
    private bool _isLoading = true;
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        var response = await ApiService.GetAudioTaskByIdAsync(TaskId);
        if (response.IsSuccess && response.Data != null)
        {
            _rawServerData = response.Data;
            _segments = _rawServerData.Transcription?.Select(t => new TranscribeSegmentDto
            {
                Start = t.Start,
                End = t.End,
                Confidence = t.Confidence,
                Text = t.Text
            }).ToList() ?? new List<TranscribeSegmentDto>();
        }
        _isLoading = false;
    }

    private async Task SaveTranscript()
    {
        if (_rawServerData == null || _segments == null) return;
        _isSaving = true;

        var updatePayload = new AudioTaskUpdateRequest
        {
            Id = _rawServerData.Id,
            FileName = _rawServerData.FileName,
            Status = _rawServerData.Status,
            Transcription = _segments,
            Analysis = _rawServerData.Analysis?.Select(a => new AnalysisSegmentDto
            { Start = a.Start, End = a.End, Word = a.Word, EntityGroup = a.EntityGroup, Score = a.Score }).ToList(),
            Entities = _rawServerData.Entities
        };

        var result = await ApiService.UpdateAudioTaskAsync(updatePayload);
        if (result.IsSuccess) Nav.NavigateTo($"/player/{TaskId}");

        _isSaving = false;
    }
}