@page "/player/{TaskId}/edit/entities"
@using ClientApp.Models
@inject ApiService ApiService
@inject NavigationManager Nav

<div class="container-fluid px-4 mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bolder mb-1 text-dark">Редактор сутностей (NER)</h2>
            <div class="text-secondary" style="font-size: 1.1rem;">
                Ручна семантична розмітка транскрипту
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark px-4 fw-bold rounded-1" @onclick='() => Nav.NavigateTo($"/player/{TaskId}")'>
                Назад
            </button>
            <button class="btn btn-dark px-4 fw-bold rounded-1 d-flex align-items-center" @onclick="SaveEntities" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Збереження...</span>
                }
                else
                {
                    <span>💾 Зберегти зміни</span>
                }
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-dark" role="status"></div>
        </div>
    }
    else if (_viewTask?.Transcription != null)
    {
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card rounded-1 border shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark text-uppercase mb-3" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                            Активний інструмент
                        </h6>
                        <p class="text-secondary small mb-3">Оберіть категорію, а потім клікайте на слова в тексті праворуч.</p>

                        <div class="d-grid gap-2">
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn @(_selectedEntity == "" ? "btn-dark active-tool" : "btn-outline-dark")"
                                    @onclick='() => _selectedEntity = ""'>
                                🧹 Очистити маркер
                            </button>

                            <hr class="my-2" />

                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn LOCATION @(_selectedEntity == "LOCATION" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "LOCATION"'>
                                LOCATION
                            </button>
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn PERSONNEL-ENEMY @(_selectedEntity == "PERSONNEL-ENEMY" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "PERSONNEL-ENEMY"'>
                                PERSONNEL-ENEMY
                            </button>
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn PERSONNEL-FRIENDLY @(_selectedEntity == "PERSONNEL-FRIENDLY" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "PERSONNEL-FRIENDLY"'>
                                PERSONNEL-FRIENDLY
                            </button>
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn EQUIPMENT-ENEMY @(_selectedEntity == "EQUIPMENT-ENEMY" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "EQUIPMENT-ENEMY"'>
                                EQUIPMENT-ENEMY
                            </button>
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn EQUIPMENT-FRIENDLY @(_selectedEntity == "EQUIPMENT-FRIENDLY" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "EQUIPMENT-FRIENDLY"'>
                                EQUIPMENT-FRIENDLY
                            </button>
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn QUANTITY @(_selectedEntity == "QUANTITY" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "QUANTITY"'>
                                QUANTITY
                            </button>
                            <button class="btn btn-sm fw-bold text-start rounded-1 palette-btn CALLSIGN @(_selectedEntity == "CALLSIGN" ? "active-tool" : "inactive-tool")"
                                    @onclick='() => _selectedEntity = "CALLSIGN"'>
                                CALLSIGN
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card rounded-1 border shadow-sm">
                    <div class="card-header bg-light border-bottom py-3 px-4">
                        <h6 class="fw-bold mb-0 text-dark text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                            Робоча область транскрипту
                        </h6>
                    </div>

                    <div class="card-body p-4 transcript-area">
                        @foreach (var segment in _viewTask.Transcription)
                        {
                            <div class="mb-4">
                                <div class="words-flow text-dark" style="font-size: 1.15rem; line-height: 2.2;">
                                    @foreach (var word in segment.Transcribe)
                                    {
                                        <span class="edit-word-span rounded-1 @word.EntityGroup"
                                              @onclick="() => word.EntityGroup = string.IsNullOrEmpty(_selectedEntity) ? null : _selectedEntity">
                                            @word.Text
                                        </span>
                                        @(" ")
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string TaskId { get; set; } = "";

    private ViewAudioTask? _viewTask;

    private string _selectedEntity = "LOCATION";

    private bool _isLoading = true;
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        var response = await ApiService.GetAudioTaskByIdAsync(TaskId);
        if (response.IsSuccess && response.Data != null)
        {
            _viewTask = TranscriptNormalizer.ToViewModel(response.Data);
        }
        _isLoading = false;
    }

    private async Task SaveEntities()
    {
        if (_viewTask?.Transcription == null) return;

        _isSaving = true;

        var payloadAnalysis = new List<AnalysisSegment>();
        int globalCharCounter = 0;

        foreach (var seg in _viewTask.Transcription)
        {
            if (seg.Transcribe == null) continue;

            string reconstructedText = string.Join(" ", seg.Transcribe.Select(w => w.Text));
            int localOffset = 0;

            for (int i = 0; i < seg.Transcribe.Count; i++)
            {
                var currentWord = seg.Transcribe[i];
                int wordLen = currentWord.Text.Length;

                if (!string.IsNullOrEmpty(currentWord.EntityGroup))
                {
                    int entStart = globalCharCounter + localOffset;
                    int entEnd = entStart + wordLen;
                    string combinedWordText = currentWord.Text;

                    while (i + 1 < seg.Transcribe.Count && seg.Transcribe[i + 1].EntityGroup == currentWord.EntityGroup)
                    {
                        i++;
                        localOffset += wordLen + 1;
                        wordLen = seg.Transcribe[i].Text.Length;
                        entEnd = globalCharCounter + localOffset + wordLen;
                        combinedWordText += " " + seg.Transcribe[i].Text;
                    }

                    payloadAnalysis.Add(new AnalysisSegment(
                        entStart,
                        entEnd,
                        combinedWordText,
                        1.0,
                        currentWord.EntityGroup
                    ));
                }
                localOffset += wordLen + 1;
            }
            globalCharCounter += reconstructedText.Length + 1;
        }

        var updatePayload = new AudioTaskUpdate
        {
            Analysis = payloadAnalysis,
            Entities = payloadAnalysis.Select(a => a.EntityGroup).Distinct().ToList()
        };

        var result = await ApiService.UpdateAnalysisAudioTaskAsync(TaskId, updatePayload);

        if (result.IsSuccess) Nav.NavigateTo($"/player/{TaskId}");

        _isSaving = false;
    }
}